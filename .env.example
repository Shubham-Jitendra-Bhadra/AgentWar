# --- W&B Inference (OpenAI-compatible endpoint) ---
# Get your key from https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# W&B Inference endpoint + a served model id.
# See https://wandb.ai/inference for available models.
WANDB_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
WANDB_MODEL=openai/gpt-oss-20b

# Your W&B team/entity and project (used for tracking + the leaderboard)
WANDB_ENTITY=your_wandb_team
WANDB_PROJECT=agentwar

# --- Optional: Anthropic, if you want to power agents with Claude directly ---
# ANTHROPIC_API_KEY=sk-ant-...
    